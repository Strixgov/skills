{
  "name": "@strixgov/verifier",
  "version": "1.22.0",
  "description": "Independent verification of Strix governance evidence, approval artifacts, linked attestations, tool-gateway authorization receipts, signed execution outcomes, chain snapshots, and connected-mode wire envelopes. Offline-capable. No Strix account required.",
  "license": "MIT",
  "bin": {
    "strix-verify": "bin/verify.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./evidence-contract": {
      "import": "./src/evidence-contract.mjs",
      "default": "./src/evidence-contract.mjs"
    },
    "./verify-v2": {
      "import": "./src/verify-v2.mjs",
      "default": "./src/verify-v2.mjs"
    },
    "./execution-outcome": {
      "import": "./src/execution-outcome.mjs",
      "default": "./src/execution-outcome.mjs"
    },
    "./agent-session": {
      "import": "./src/agent-session.mjs",
      "default": "./src/agent-session.mjs"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "strix",
    "governance",
    "verification",
    "ed25519",
    "proof",
    "evidence",
    "execution-outcomes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Strixgov/strix",
    "directory": "packages/strixgov-verifier"
  }
}
